# secrets — never commit these.
# ".env" alone matches ONLY a file literally called .env, not mken.env, so the
# env files need naming explicitly. The .example is safe and is meant to ship.
client_secret.json
token.json
.env
*.env
mken.env
cookies.txt
!*.env.example

